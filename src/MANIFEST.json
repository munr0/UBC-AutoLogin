{
    "manifest_version": 3,
    "name": "UBC AutoLogin",
    "version": "1.1",
    "description": "A lightweight utility to automatically log you into UBC services using your CWL.",
    "homepage_url": "https://github.com/munr0/UBC-AutoLogin",
    "icons": {
        "128": "icon.png"
    },
    "action": {
        "default_title": "Configure CWL",
        "default_popup": "popup.html"
    },
    "permissions": [
        "storage"
    ],
    "content_scripts": [
        {
            "matches": [
                "https://authentication.ubc.ca/*",
                "https://payforprint.ubc.ca/user",
                "https://ipeer.elearning.ubc.ca/login"
            ],
            "js": [
                "content_script.js"
            ]
        }
    ]
}
